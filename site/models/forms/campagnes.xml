<?xml version="1.0" encoding="utf-8"?>
<form>
	<field
                name="id_campagne"
                type="hidden"
                        />
        <field
                name="active"
                type="hidden"
                        />

    <field
        name="titre"
        type="text"
        label="COM_GDA_CAMPAGNE_F_TITRE"
        size="40"
        class="inputbox "
        labelclass="gda-label-icon gda-icon-titre"
        required="true" />

    <field
                name="description"
                type="textarea" 
                label="COM_GDA_CAMPAGNE_F_DESCRIPTION"
                rows="3" 
                cols="255"
                class=""
                labelclass="gda-label-icon gda-icon-description"
         />
        <field
                name="nbr_place"
                type="integer"
                label="Nombre de place"
                description="Nombre de place disponible. (Mettre 0 si pas de limite)"
                first="0"
                last="200"
                step="1"
        />

        <field
                name="reservation_multiple"
                type="radio"
                label="COM_GDA_CAMPAGNE_RESERVATION_MULTIPLE"
                labelclass="gda-label-icon gda-icon-multiple"
                description="COM_GDA_CAMPAGNE_RESERVATION_MULTIPLE_DESC"
                default="0"
                layout="joomla.form.field.radio.switcher"
                filter="integer">
                <option value="0">JNO</option>
                <option value="1">JYES</option>
        </field>

    <field
                name="date_debut"
                type="calendar"
                default="5"
                label="COM_GDA_CAMPAGNE_DATE_OPENING_RESERVATION"
                labelclass="gda-label-icon gda-icon-ouverture"
                description=""
                class="input-small"
                required="true"
                showtime="false"
                todaybutton="true"
                filltable="false"
                translateformat="false"
                format="%d/%m/%Y"
                filterformat="d/m/Y"
                pattern="(0[1-9]|[12][0-9]|3[01])[/](0[1-9]|1[012])[/](19|20)\d\d"
                minyear="-2"
                maxyear="2"
	/>
    <field
                name="date_evenement"
                type="calendar"
                label="COM_GDA_CAMPAGNE_DATE_EVENEMENT"
                labelclass="gda-label-icon gda-icon-evenement"
                description="COM_GDA_CAMPAGNE_DATE_EVENEMENT_DESC"
                class="input-small"
                showtime="true"
                todaybutton="true"
                filltable="false"
                translateformat="false"
                format="%d/%m/%Y %H:%M"
                filterformat="d/m/Y H:i"
                minyear="-2"
                maxyear="2"
	/>

	<field
                name="date_fin"
                type="calendar"
                default="5"
                label="COM_GDA_CAMPAGNE_DATE_CLOSING_RESERVATION"
                labelclass="gda-label-icon gda-icon-fermeture"
                description=""
                class="input-small"
                required="true"
                showtime="false"
                todaybutton="true"
                filltable="false"
                translateformat="false"
                format="%d/%m/%Y"
                filterformat="d/m/Y"
                pattern="(0[1-9]|[12][0-9]|3[01])[/](0[1-9]|1[012])[/](19|20)\d\d"
                minyear="-2"
                maxyear="2"
	/>


	<field 
                name="id_article"
                type="ArticlesByTag"
                label="COM_GDA_CAMPAGNE_F_ARTICLE"
                labelclass="gda-label-icon gda-icon-article"
                description="Choisissez un article pour le lier à cette campagne"
        />

        <field
                name="event_helloasso"
                type="EventsHelloAsso"
                formtype="Event,Shop"
                label="Event HelloAsso"
                description="Choisissez un event HelloAsso pour le lier à cette campagne"
        />

	<field 
                name="id_type"
                type="TypeDeCampagne"
                label="COM_GDA_CAMPAGNE_F_TYPE"
                required="true"
                labelclass="gda-label-icon gda-icon-type"
        />

        <field
                name="sous_type"
                type="list"
                label="COM_GDA_CAMPAGNE_F_SOUS_TYPE"
                labelclass="gda-label-icon gda-icon-soustype"
        >
                <option value="">COM_GDA_CAMPAGNE_F_SOUS_TYPE_AUCUN</option>
                <option value="fosse_apnee">COM_GDA_CAMPAGNE_SOUS_TYPE_FOSSE_APNEE</option>
                <option value="fosse_technique_20">COM_GDA_CAMPAGNE_SOUS_TYPE_FOSSE_TECHNIQUE_20</option>
                <option value="fosse_technique_12">COM_GDA_CAMPAGNE_SOUS_TYPE_FOSSE_TECHNIQUE_12</option>
                <option value="rifax">COM_GDA_CAMPAGNE_SOUS_TYPE_RIFAX</option>
        </field>

        <field
                name="id_responsable"
                type="ResponsableCampagne"
                label="COM_GDA_CAMPAGNE_RESPONSABLE"
                labelclass="gda-label-icon gda-icon-responsable"
                description="COM_GDA_CAMPAGNE_RESPONSABLE_DESC"
        />

        <field
                name="id_groupes"
                type="multiselect"
                multiple="true"
                table="#__gda_groupes"
                key_field="id_groupe"
                value_field="groupe_name"
                ordering="groupe_tri ASC"
                label="COM_GDA_CAMPAGNE_F_GROUPES"
                labelclass="gda-label-icon gda-icon-groupes"
        />

       

</form>